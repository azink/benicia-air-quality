# OpenAQ API Key — FREE at https://openaq.org/register
# Required to fetch official BAAQMD/CARB monitoring station data near Benicia
OPENAQ_API_KEY=your_openaq_key_here

# PurpleAir Read API Key — FREE at https://develop.purpleair.com/
# Optional: adds hyperlocal community sensor data in Benicia
PURPLEAIR_READ_KEY=

# Server port (default: 3001)
PORT=3001
